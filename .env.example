# Sprucer local env (copy to .env — never commit .env)

SPRUCER_HOST=127.0.0.1
SPRUCER_PORT=8787
SPRUCER_DATABASE_URL=sqlite:///./data/sprucer.db

# Auth: dev | none | oidc | api_key | demo
# dev is for local single-user only — do not expose to the internet
# demo = anonymous per-session sandbox vaults (see deploy/compose.demo.yml)
SPRUCER_AUTH_MODE=dev
# Change both of these before first login / Docker up
SPRUCER_DEV_PASSWORD=change-me-dev-password
SPRUCER_SESSION_SECRET=change-me-long-random-session-secret
SPRUCER_API_KEYS=

# Required when binding SPRUCER_HOST=0.0.0.0 with auth_mode=dev|none (Docker desktop stacks)
# SPRUCER_ALLOW_INSECURE_DEV=1
# SPRUCER_COOKIE_SECURE=0
# SPRUCER_DOCS_ENABLED=1

# OpenAI-compatible chat completions
SPRUCER_LLM_URL=http://127.0.0.1:4000/v1
SPRUCER_LLM_API_KEY=sk-change-me
SPRUCER_LLM_MODEL=qwen-coder

# Demo mode: fully self-contained, no external calls or costs.
# Uses an offline generator, per-session ephemeral vaults, and disables URL ingest.
# SPRUCER_DEMO=1
# SPRUCER_DEMO_TTL_HOURS=24
# SPRUCER_INGEST_URL_ENABLED=1
# Bring-your-own-key proxy: let a visitor supply their own OpenAI-compatible provider.
# Their key stays in the browser and is proxied per request (never stored server-side).
# SPRUCER_BYOK_ENABLED=0
# SPRUCER_BYOK_ALLOWED_HOSTS=

# OIDC (when SPRUCER_AUTH_MODE=oidc) — see deploy/env.oidc.example
SPRUCER_OIDC_ISSUER=
SPRUCER_OIDC_CLIENT_ID=
SPRUCER_OIDC_CLIENT_SECRET=
SPRUCER_OIDC_REDIRECT_URI=http://127.0.0.1:3737/v1/auth/oidc/callback
SPRUCER_OIDC_POST_LOGIN_REDIRECT=http://127.0.0.1:3737/applications

# Web → API
SPRUCER_PUBLIC_URL=http://127.0.0.1:8787
NEXT_PUBLIC_SPRUCER_API_URL=http://127.0.0.1:8787
SPRUCER_CORS_ORIGINS=http://127.0.0.1:3737,http://localhost:3737
