# Env template for deploy/compose.authentik.yml
# Copy to .env.authentik — never commit secrets.

POSTGRES_PASSWORD=change-me-long-random
SPRUCER_SESSION_SECRET=change-me-another-long-random

PUBLIC_WEB_ORIGIN=https://sprucer.example.com
SPRUCER_CORS_ORIGINS=https://sprucer.example.com
WEB_HOST_PORT=3737

# Authentik application issuer (Provider → OpenID Configuration Issuer)
SPRUCER_OIDC_ISSUER=https://auth.example.com/application/o/sprucer/
SPRUCER_OIDC_CLIENT_ID=
SPRUCER_OIDC_CLIENT_SECRET=
SPRUCER_OIDC_REDIRECT_URI=https://sprucer.example.com/v1/auth/oidc/callback
SPRUCER_OIDC_POST_LOGIN_REDIRECT=https://sprucer.example.com/applications

SPRUCER_LLM_URL=https://api.openai.com/v1
SPRUCER_LLM_API_KEY=
SPRUCER_LLM_MODEL=gpt-4o-mini

SPRUCER_COOKIE_SECURE=1
