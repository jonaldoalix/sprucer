# Self-contained demo env (copy to .env when using deploy/compose.demo.yml).
# The demo needs no LLM provider, no OIDC, and no secrets to run.

# Sweep stale per-session demo vaults older than this many hours.
SPRUCER_DEMO_TTL_HOURS=24

# Bring-your-own-key proxy: let visitors use their own OpenAI-compatible provider.
# Their key stays in their browser and is proxied per request (never stored server-side).
SPRUCER_BYOK_ENABLED=1
# Optional provider allowlist (comma-separated hosts). Empty = any public https host.
SPRUCER_BYOK_ALLOWED_HOSTS=

# Only used to sign per-session demo cookies. Any long random value is fine.
SPRUCER_SESSION_SECRET=change-me-long-random-session-secret

# Set 1 when serving over HTTPS so session cookies get the Secure flag.
SPRUCER_COOKIE_SECURE=0
